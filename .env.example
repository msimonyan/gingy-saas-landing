# Gingy SaaS Landing - Environment Variables
# Copy to .env.local and fill in your values

# API base URL (gingy-saas-api) - required for live billing
# Example: http://127.0.0.1:8000 (local) or https://api.gingy.com (production)
NEXT_PUBLIC_API_URL=

# Panel/dashboard URL - where users go after payment
# Example: http://127.0.0.1:9000 (local) or https://app.gingy.com (production)
# Used for "Go to Dashboard" on checkout return page
NEXT_PUBLIC_PANEL_URL=
